# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real credentials.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (operational DB: source registry, versions, review workflow, audit log) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change_me_dev_only

# --- Qdrant (vector DB: hybrid dense+sparse search) ---
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Set if you enable Qdrant API key auth (recommended once exposed beyond localhost)
QDRANT_API_KEY=

# --- Fetcher (Phase 2, present here for forward-compat, unused in Phase 1) ---
FETCHER_CONTACT_EMAIL=vyanktesh.arali@roibypractus.com
FETCHER_USER_AGENT=ConsulateRAGBot/0.1 (+mailto:vyanktesh.arali@roibypractus.com)

# --- Generation backend (Phase 7 follow-up) ---
# "qwen" (default): self-hosted via llama.cpp, nothing leaves this machine.
# "gemini": routes generation to Google's API instead -- much faster, but
# every question + retrieved source excerpt is sent to Google for that
# turn. Opt-in only; see app/generation/gemini_backend.py.
GENERATION_BACKEND=qwen

# Only needed if GENERATION_BACKEND=gemini above. Get a free key from
# https://aistudio.google.com/apikey -- do NOT commit a real key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini-2.5-flash spends part of its token budget on internal "thinking"
# before writing the visible answer, which can truncate/empty out short
# budgets. thinking_budget=0 disables that; raise GEMINI_MAX_OUTPUT_TOKENS
# if answers still get cut off.
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_THINKING_BUDGET=0
