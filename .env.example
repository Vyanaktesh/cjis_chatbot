# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real credentials.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- CORS ---
# "*" (default) allows any website's browser JS to call this API -- fine
# for local dev, but MUST be locked down before a real deployment: with
# "*", any site could call the write endpoints (/support/ticket,
# /citizen-corner/submit) using a visitor's own browser session. Set to
# the real consulate site's origin(s) once known, comma-separated, e.g.
# CORS_ALLOWED_ORIGINS=https://www.indiainatlanta.gov.in
CORS_ALLOWED_ORIGINS=*

# --- Rate limiting (per client IP; "<n>/<period>", see the `limits` package
# syntax) --- guards against quota/cost blowups on /chat and /generate, and
# ticket-spam on /support/ticket and /citizen-corner/submit. Defaults are
# generous for normal single-user browsing; tighten for a public launch.
RATE_LIMIT_GENERATE=20/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_SUBMIT=5/minute
# Where the counters are kept. "memory://" is per-process; with more than one
# worker use a shared store, e.g. redis://redis:6379 (needs `pip install redis`).
# Behind a reverse proxy/load balancer you ALSO need uvicorn's proxy settings,
# otherwise every visitor shares one limit -- see LOCAL_SETUP.md, "Running
# behind a reverse proxy".
RATE_LIMIT_STORAGE_URI=memory://

# --- PostgreSQL (operational DB: source registry, versions, review workflow, audit log) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change_me_dev_only

# --- Qdrant (vector DB: hybrid dense+sparse search) ---
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Set if you enable Qdrant API key auth (recommended once exposed beyond localhost)
QDRANT_API_KEY=
# MUST be true for any remote/managed Qdrant, otherwise QDRANT_API_KEY is sent
# in cleartext. Leave false for the local docker setup (plain HTTP).
QDRANT_HTTPS=false

# --- Fetcher (Phase 2, present here for forward-compat, unused in Phase 1) ---
FETCHER_CONTACT_EMAIL=vyanktesh.arali@roibypractus.com
FETCHER_USER_AGENT=ConsulateRAGBot/0.1 (+mailto:vyanktesh.arali@roibypractus.com)

# --- Generation backend (Phase 7 follow-up) ---
# "qwen" (default): self-hosted via llama.cpp, nothing leaves this machine.
# "gemini": routes generation to Google's API instead -- much faster, but
# every question + retrieved source excerpt is sent to Google for that
# turn. Opt-in only; see app/generation/gemini_backend.py.
GENERATION_BACKEND=qwen

# Only needed if GENERATION_BACKEND=gemini above. Get a free key from
# https://aistudio.google.com/apikey -- do NOT commit a real key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini-2.5-flash spends part of its token budget on internal "thinking"
# before writing the visible answer, which can truncate/empty out short
# budgets. thinking_budget=0 disables that; raise GEMINI_MAX_OUTPUT_TOKENS
# if answers still get cut off.
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_THINKING_BUDGET=0

# --- Retrieval reranking ---
# Cross-encoder rerank of the top RETRIEVAL_RERANK_CANDIDATES hybrid-search
# results before cutting down to the caller's requested limit (see
# app/retrieval/reranker.py). Improves accuracy (added after kb_admin's
# eval golden set, built from real citizen queries, showed short/
# keyword-style queries often rank the correct chunk too low from hybrid
# search alone) but BAAI/bge-reranker-v2-m3 is too slow on CPU-only
# hardware for this live chat path (~2-8s per candidate scored, measured
# live) -- leave this OFF here. consulate-kb-admin's own .env turns it on
# for offline eval runs instead, where the extra latency doesn't matter.
RETRIEVAL_RERANK=false
RETRIEVAL_RERANK_CANDIDATES=30

# --- Off-topic guardrail ---
# Before ever running full retrieval or calling the generation backend, one
# cheap raw dense-only cosine similarity lookup (app.retrieval.retriever.
# probe_relevance) checks the query against the closest approved chunk.
# Below this floor, the turn is declined with a short polite message
# instead. Calibrated against this deployment's real approved-chunk set:
# off-topic queries ("what is a cat", "capital of France") scored
# 0.36-0.45; genuinely on-topic ones ("how do I renew my passport") scored
# 0.70-0.73 -- wide gap, 0.55 sits in the middle. Re-probe if this drifts
# as more sources get approved.
RETRIEVAL_MIN_RELEVANCE=0.55

# --- HubSpot escalation ---
# When the chatbot can't ground an answer, the widget offers to escalate to
# a human: a Contact is upserted by email, then a Ticket is created and
# associated to it (see app/integrations/hubspot.py and POST
# /support/ticket in app/api/main.py). Server-side only -- never sent to
# the frontend. Get a token from a HubSpot private app (Settings >
# Integrations > Private Apps) with crm.objects.contacts.write and
# crm.objects.tickets.write scopes.
HUBSPOT_ACCESS_TOKEN=
# HubSpot's default Support Pipeline ("0") and its first stage ("1") --
# works out of the box on a fresh portal. Point these at a specific
# pipeline/stage (Settings > Objects > Tickets > Pipelines) once one exists
# for this chatbot specifically.
HUBSPOT_TICKET_PIPELINE_ID=0
HUBSPOT_TICKET_STAGE_ID=1

# --- HubSpot Citizen Corner (testimonials/feedback/photos, PRD FR-5.x) ---
# Separate dedicated pipeline from the escalation one above. Needs, on the
# HubSpot side: the "files" scope added to the access token above, a new
# "Citizen Corner" ticket pipeline (stages: Pending Review / Approved /
# Rejected), and two custom ticket properties named exactly is_anonumous
# (checkbox) and photo_url (single-line text) -- see
# app/integrations/hubspot.py's create_citizen_submission. Left unset
# until that setup is done; submissions fail with a clear error (not a
# crash) until both ids below are filled in.
HUBSPOT_CITIZEN_PIPELINE_ID=
HUBSPOT_CITIZEN_STAGE_PENDING_ID=

# --- Robustness / timeouts ---
# A single Gemini call is abandoned after this many seconds; the whole request
# (including rate-limit retries) after the total budget.
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TOTAL_BUDGET_SECONDS=45
# Who can open a Citizen Corner photo link: PUBLIC_NOT_INDEXABLE (default, not
# listed by search engines) or PRIVATE (staff only, needs a signed link).
HUBSPOT_PHOTO_ACCESS=PUBLIC_NOT_INDEXABLE
# Load the embedding model in the background at startup so the first visitor
# does not wait ~15s. Set false for tests / constrained machines.
WARMUP_ON_STARTUP=true
# Requests announcing a larger body than this (bytes) get HTTP 413.
MAX_REQUEST_BODY_BYTES=10485760
# Extra words that always count as on-topic for the off-topic guardrail
# (comma-separated); the built-in list covers OCI, passport, visa, etc.
# RETRIEVAL_DOMAIN_KEYWORDS=

# --- Production ---
# With APP_ENV=production the API refuses to start if CORS is "*", the
# Postgres password is the development default, or similar unsafe settings.
